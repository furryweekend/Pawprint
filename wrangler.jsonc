{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "pawprint",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-29",
	"observability": {
		"enabled": true
	},
	"assets": {
		"directory": "./public/",
		"binding": "ASSETS"
	},
	"kv_namespaces": [
		{
			"binding": "CONFIG_KV",
			"id": "4758ed0249fc47a1a2f8a71fbd92ed52"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pawprint-analytics",
			"database_id": "03936c0e-d16c-42fa-a7bb-7763d364a4df",
			"migrations_dir": "./migrations"
		}
	]
}
